+  async function reserveIntakeRun({ runId, receiptId, expectedRevision, now = Date.now() }) {
+    const out = await q(`UPDATE tm_run SET intake_receipt_id = ? WHERE run_id = ? AND revision = ? AND state = 'IN_PROGRESS'
